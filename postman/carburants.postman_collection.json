{
  "info": {
    "name": "Atelier 4 - Carburants web services",
    "description": "Tests of the three services. Fill apiPassword in the collection variables (the password you typed in start-wildfly.ps1) and keep it out of Git and out of screenshots. SOAP bodies are written from the Java contract; if one is refused, import the WSDL ({{soapUrl}}?wsdl) in Postman or SoapUI to generate the exact request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "soapUrl",
      "value": "http://localhost:8081/carburants-soap/CarburantsService",
      "type": "default"
    },
    {
      "key": "restUrl",
      "value": "http://localhost:8081/carburants-rest/api",
      "type": "default"
    },
    {
      "key": "jerseyUrl",
      "value": "http://localhost:8081/carburants-jersey/api",
      "type": "default"
    },
    {
      "key": "apiUser",
      "value": "admin",
      "type": "default"
    },
    {
      "key": "apiPassword",
      "value": "",
      "type": "default"
    },
    {
      "key": "token",
      "value": "",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "JAX-WS (SOAP)",
      "item": [
        {
          "name": "S1. prixCarburants (nom_station, date)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{apiUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{apiPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:ns=\"http://carburants.fstt.ma/soap\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <ns:prixCarburants>\n      <nom_station>Station Malabata</nom_station>\n      <date>2026-11-08</date>\n    </ns:prixCarburants>\n  </soapenv:Body>\n</soapenv:Envelope>"
            },
            "url": {
              "raw": "{{soapUrl}}",
              "host": [
                "{{soapUrl}}"
              ]
            },
            "description": "The shared method of the subject, on the JAX-WS service."
          }
        },
        {
          "name": "S2. listerStations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              }
