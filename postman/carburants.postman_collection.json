    {
      "name": "JAX-RS (RESTEasy)",
      "item": [
        {
          "name": "1. Login (stores the token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('a token is returned', function () { pm.expect(body.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{apiUser}}\",\n  \"password\": \"{{apiPassword}}\"\n}"
            },
            "url": {
              "raw": "{{restUrl}}/auth/login",
              "host": [
                "{{restUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "2. Prices on a day of change (2026-11-08)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "var b = pm.response.json();pm.test('two fuels are returned', function () { pm.expect(b.prix.length).to.eql(2); });pm.test('new Gasoil price', function () { pm.expect(Number(b.prix[0].prix)).to.eql(10.62); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{restUrl}}/prix?station=Station Malabata&date=2026-11-08",
              "host": [
                "{{restUrl}}"
              ],
              "path": [
                "prix"
              ],
              "query": [
                {
                  "key": "station",
                  "value": "Station Malabata"
                },
                {
                  "key": "date",
                  "value": "2026-11-08"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "3. Prices between two changes (2026-11-05)",
